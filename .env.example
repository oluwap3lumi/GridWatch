# Local development only. Replace the placeholder before sharing a deployment.
POSTGRES_USER=gridwatch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gridwatch
API_PORT=8000
WEB_PORT=5173

# Synthetic generator defaults; changes take effect after make up recreates the API.
SEED_RANDOM=42
SEED_ASSET_COUNT=3000
SEED_FEEDER_COUNT=20
SEED_TRANSFORMER_COUNT=700
SEED_DAYS=730
SEED_AS_OF=2025-12-31
SEED_BBOX=3.25,6.42,3.55,6.65

# Deterministic CPU model training (monthly 30-day target).
TRAIN_RANDOM=42

# Private runtime data; never commit upload or staging contents.
UPLOAD_STAGING_DIR=uploads/staging
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FEATURES=100000
UPLOAD_MAX_EXPANDED_BYTES=262144000
UPLOAD_MAX_ZIP_FILES=32
UPLOAD_MAX_ZIP_RATIO=100
UPLOAD_TTL_SECONDS=86400
